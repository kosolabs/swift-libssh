{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all"
  ],
  "schedule": [
    "at any time"
  ],
  "semanticCommitType": "fix",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "groupName": "CLibSSH native dependencies",
      "matchDepNames": [
        "openssl/openssl",
        "libssh/libssh-mirror"
      ],
      "automerge": true,
      "postUpgradeTasks": {
        "commands": [
          "./build.sh"
        ],
        "executionMode": "branch",
        "fileFilters": [
          "build.sh",
          "Sources/CLibSSH.xcframework/**"
        ]
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build\\.sh$/"
      ],
      "matchStrings": [
        "export OPENSSL=openssl-(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "openssl/openssl",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^openssl-(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build\\.sh$/"
      ],
      "matchStrings": [
        "export LIBSSH=libssh-(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "libssh/libssh-mirror",
      "datasourceTemplate": "gitlab-tags",
      "extractVersionTemplate": "^libssh-(?<version>.*)$"
    }
  ]
}
